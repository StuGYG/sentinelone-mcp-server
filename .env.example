# SentinelOne API Configuration
#
# Recommended: create a Service User rather than using a personal token --
#   Settings > Users > Service Users > Create New Service User
# Personal tokens live at: Profile > My Profile > API token operations
#
# The token is an ES256 JWT: several hundred chars, exactly two '.' separators.
# It is shown ONCE. Verify it stored intact -- a truncated token returns the
# same "Authentication Failed" (4010010) as an expired one:
#   printf '%s' "$SENTINELONE_API_KEY" | tr -cd '.' | wc -c   # expect 2

# Required: Your SentinelOne API key
SENTINELONE_API_KEY=your_api_key_here

# Required: Your SentinelOne management console URL (no trailing slash)
# Example: https://usea1-purple.sentinelone.net
SENTINELONE_API_BASE=https://your-instance.sentinelone.net
